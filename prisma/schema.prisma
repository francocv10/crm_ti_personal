generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model client {
  id_client  Int        @id @default(autoincrement())
  first_name String     @db.VarChar(20)
  last_name  String     @db.VarChar(25)
  company    String     @db.VarChar(40)
  number     String?    @db.VarChar(20)
  email      String     @db.VarChar(50)
  address    String?    @db.VarChar(255)
  id_rol     Int?
  rol        rol?       @relation(fields: [id_rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction)
  project    project[]
  services   services[]
}

model project {
  id_project   Int        @id @default(autoincrement())
  name_project String     @unique @db.VarChar(40)
  id_client    Int?
  description  String?    @db.VarChar(255)
  state        String?    @db.VarChar(20)
  initial_date DateTime   @db.Date
  deadline     DateTime   @db.Date
  created_at   DateTime?  @db.Timestamp(6)
  client       client?    @relation(fields: [id_client], references: [id_client], onDelete: NoAction, onUpdate: NoAction)
  services     services[]
  tickets      tickets[]
}

model rol {
  id_rol      Int      @id @default(autoincrement())
  rol         String   @db.VarChar(10)
  intern_key  String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  client      client[]
  users       users[]
}

model services {
  id_services     Int      @id @default(autoincrement())
  name_services   String   @db.VarChar(100)
  id_client       Int?
  id_project      Int?
  charge_client   Int
  cost            Int
  date_renovation DateTime @db.Date
  expiration_days String   @db.VarChar
  client          client?  @relation(fields: [id_client], references: [id_client], onDelete: NoAction, onUpdate: NoAction)
  project         project? @relation(fields: [id_project], references: [id_project], onDelete: NoAction, onUpdate: NoAction)
}

model tickets {
  id_ticket    Int      @id @default(autoincrement())
  name_ticket  String   @db.VarChar(20)
  id_project   Int?
  assignee_id  Int?
  priority     String?  @db.VarChar(20)
  state_ticket String?  @db.VarChar(20)
  users        users?   @relation(fields: [assignee_id], references: [id_user], onDelete: NoAction, onUpdate: NoAction)
  project      project? @relation(fields: [id_project], references: [id_project], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id_user    Int       @id @default(autoincrement())
  first_name String    @db.VarChar(20)
  last_name  String    @db.VarChar(25)
  user_name  String    @unique @db.VarChar(20)
  email      String    @db.VarChar(50)
  password   String    @db.VarChar(255)
  id_rol     Int?
  created_at DateTime? @db.Timestamp(6)
  tickets    tickets[]
  rol        rol?      @relation(fields: [id_rol], references: [id_rol], onDelete: NoAction, onUpdate: NoAction)
}
